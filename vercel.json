{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.snavtourism.com" }],
      "destination": "https://www.snavtourism.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/newsletter/send", "schedule": "0 8 * * 6" }
  ]
}