# ===== Batch B: Email system ====
# SMTP credentials (user will provide) — used by nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Business inbox that receives contact-form inquiries
CONTACT_TO=

# ===== Newsletter =====
# Protect /api/newsletter/send (Vercel Cron sends Authorization: Bearer <value>)
CRON_SECRET=

# Subscriber storage (free Upstash Redis: https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== AI newsletter generation (NVIDIA NIM) =====
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=mistralai/mistral-nemotron
NVIDIA_FALLBACK_MODEL=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1